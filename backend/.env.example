# Set deployment variables or use the ignored repository-root .env for local development.
# Runtime uses the Neon pooled PostgreSQL URL. Migrations require the separate direct URL.
DATABASE_URL=
DIRECT_URL=
# Optional HTTP settings. Omit blank entries to use local defaults.
# PORT=
# HOST=
# CORS_ORIGINS=
# NODE_ENV=development
# REP_RIVALS_HEALTH_ONLY=true
# Normal production mode requires an explicit list of HTTPS CORS_ORIGINS.
# Optional exact ingress IPs/CIDRs, only for a known forwarding proxy.
# TRUSTED_PROXY_CIDRS=
