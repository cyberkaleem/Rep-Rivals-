{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup:vision": "node scripts/setup-vision.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev": "node scripts/check-vision.mjs && vite",
    "build": "node scripts/check-vision.mjs && vite build",
    "preview": "vite preview",
    "android:sync": "pnpm setup:vision && pnpm build --mode android && cap sync android && pnpm android:verify",
    "android:verify": "node scripts/check-android-assets.mjs",
    "android:open": "cap open android",
    "android:build": "pnpm android:sync && cd android && gradlew.bat assembleDebug",
    "format": "oxfmt"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@mediapipe/tasks-vision": "1.2.0",
    "lucide-react": "1.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "5.0.5"
  }
}
